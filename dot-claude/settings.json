  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.nuget.org",
        "api.nuget.org",
        "pkgs.dev.azure.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.nuget/packages",
        "~/.local/share/NuGet",
        "~/.dotnet",
        "~/.templateengine"
      ],
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "."
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "docker *",
      "gh *",
      "dotnet test:*"
    ]
  },
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": false,
        "sendNames": true
      }
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "theme": "auto",
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(pwsh scripts/verify.ps1:*)",
      "Bash(pwsh scripts/check.ps1:*)",
      "Bash(pwsh scripts/verify-receipt.ps1:*)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(pwsh scripts/query-logs.ps1 * -Slot prod*)"
    ],
