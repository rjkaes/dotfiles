{
  "respectGitignore": true,
  "env": {
    "CLAUDE_CODE_DISABLE_WORKFLOWS": "1",
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "PONYTAIL_SUBAGENT_MATCHER": "^(?!(explore|spec-reviewer|technical-writer|.*-consultant|claude-code-guide|statusline-setup|comment-analyzer)$)"
  },
  "skillListingMaxDescChars": 200,
  "bashOutputMaxChars": 10000,
  "deniedMcpServers": [
    { "serverName": "claude.ai Intuit QuickBooks" },
    { "serverName": "claude.ai Gmail" },
    { "serverName": "claude.ai Claude Docs" },
    { "serverName": "claude.ai Adobe for creativity" },
    { "serverName": "claude.ai Microsoft 365" },
    { "serverName": "claude.ai WordPress.com" },
    { "serverName": "claude.ai monday.com" },
    { "serverName": "claude.ai Apollo.io" },
    { "serverName": "claude.ai ZoomInfo" },
    { "serverName": "claude.ai ClickUp" },
    { "serverName": "claude.ai Canva" },
    { "serverName": "claude.ai Miro" }
  ],
  "cleanupPeriodDays": 30,
  "includeGitInstructions": true,
  "permissions": {
    "allow": [
      "mcp__claude_ai_Context7__resolve-library-id",
      "mcp__claude_ai_Microsoft_Learn__*",
      "mcp__plugin_context-mode_context-mode__*",
      "mcp__plugin:context-mode:context-mode__*",
      "mcp__plugin_trueline-mcp_mcp__*",
      "mcp__plugin_trueline-mcp_trueline__*",
      "Bash(gh issue close:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr comment *)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Bash(gh-pr-review-post *)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rmdir /*)",
      "Bash(sudo *)",
      "Bash(chmod -R 777 *)",
      "Bash(> *)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/*credentials*)",
      "Read(**/*secret*.env)",
      "Read(**/*secret*.json)",
      "Read(**/*secret*.yaml)",
      "Read(**/*secret*.yml)",
      "Read(**/*secret*.key)",
      "Read(**/*secret*.pem)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "neovim": "off",
    "dataviz": "off",
    "claude-api": "off",
    "plugin-authoring": "off",
    "workflow-authoring": "off",
    "context-mode-workflow": "off",
    "claude-mem-mcp": "off",
    "brutal-review": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/rjk/.claude/hooks/context-mode-cache-heal.mjs\""
          },
          {
            "type": "command",
            "command": "\"/Users/rjk/.claude/hooks/context-mode-drop-agent-matcher.mjs\""
          },
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/terse-drop-reminder.mjs"
          },
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/ponytail-short-instructions.mjs"
          },
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/hide-plugin-skills.mjs"
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/inject-delegate-directive.sh session"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/inject-subagent-instructions.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/inject-delegate-directive.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|mcp__.*trueline_edit|Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/enforce-subagent.sh"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|mcp__.*trueline_(read|search|outline)",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/advise-explore.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|mcp__.*trueline_edit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/tmp-path-guard"
          },
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/plan-guard"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/agent-input-guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/sleep-guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/docs-gate"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*trueline_edit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/no-gemini-guard"
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/handback-size-guard"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rjk/.claude/hooks/handback-size-guard"
          }
        ]
      }
    ],
    "SessionEnd": []
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ast-grep@ast-grep-marketplace": true,
    "csharp-lsp@claude-plugins-official": true,
    "agent-orchestration@claude-code-workflows": false,
    "agent-teams@claude-code-workflows": false,
    "application-performance@claude-code-workflows": false,
    "backend-api-security@claude-code-workflows": false,
    "backend-development@claude-code-workflows": true,
    "cicd-automation@claude-code-workflows": false,
    "code-refactoring@claude-code-workflows": true,
    "codebase-cleanup@claude-code-workflows": false,
    "comprehensive-review@claude-code-workflows": false,
    "conductor@claude-code-workflows": false,
    "context-management@claude-code-workflows": false,
    "database-design@claude-code-workflows": false,
    "database-migrations@claude-code-workflows": false,
    "debugging-toolkit@claude-code-workflows": true,
    "developer-essentials@claude-code-workflows": false,
    "dotnet-contribution@claude-code-workflows": true,
    "error-debugging@claude-code-workflows": false,
    "error-diagnostics@claude-code-workflows": false,
    "frontend-mobile-security@claude-code-workflows": false,
    "full-stack-orchestration@claude-code-workflows": false,
    "git-pr-workflows@claude-code-workflows": false,
    "performance-testing-review@claude-code-workflows": false,
    "reverse-engineering@claude-code-workflows": false,
    "security-scanning@claude-code-workflows": false,
    "shell-scripting@claude-code-workflows": false,
    "systems-programming@claude-code-workflows": false,
    "tdd-workflows@claude-code-workflows": false,
    "caveman@caveman": false,
    "javascript-typescript@claude-code-workflows": false,
    "context-mode@context-mode": true,
    "mattpocock-skills@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "ast-grep-marketplace": {
      "source": {
        "source": "github",
        "repo": "ast-grep/agent-skill"
      }
    },
    "rjk-local": {
      "source": {
        "source": "directory",
        "path": "/Users/rjk/SynologyDrive/Drive/dotfiles/dot-claude/plugins/local-marketplace"
      }
    },
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.nuget.org",
        "api.nuget.org",
        "pkgs.dev.azure.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.nuget/packages",
        "~/.local/share/NuGet",
        "~/.dotnet",
        "~/.templateengine"
      ],
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "."
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "docker *",
      "gh *",
      "dotnet test:*"
    ]
  },
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "theme": "auto",
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "awaySummaryEnabled": false
}
