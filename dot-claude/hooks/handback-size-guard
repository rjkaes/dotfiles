#!/bin/sh
set -eu

# Long hand-backs land whole in the parent's context. Deny over the cap so
# the agent condenses. Never wedge a subagent: any parse problem allows.
cap=8000

payload=$(cat)
event="" tool="" sid=nosession aid=noagent transcript="" hlen=0 slen=0  # overwritten by eval below
eval "$(printf '%s' "$payload" | jq -r '
  "event=" + (.hook_event_name // "" | @sh) +
  " tool=" + (.tool_name // "" | @sh) +
  " sid=" + (.session_id // "nosession" | @sh) +
  " aid=" + (.agent_id // "noagent" | @sh) +
  " transcript=" + (.agent_transcript_path // "" | @sh) +
  " hlen=" + ((.tool_input.message // "" | length) | tostring | @sh) +
  " slen=" + ((.last_assistant_message // "" | length) | tostring | @sh)
' 2>/dev/null)" || true

case "$event" in
    PreToolUse)
        [ "$tool" = SubagentHandback ] || exit 0
        len=$hlen ;;
    SubagentStop)
        # The report already went out via the tool; blocking would only keep
        # the agent running.
        if [ -n "$transcript" ] && [ -f "$transcript" ] &&
            grep -Eq '"name": *"SubagentHandback"' "$transcript"; then
            exit 0
        fi
        len=$slen ;;
    *) exit 0 ;;
esac

[ "$len" -gt "$cap" ] || exit 0

# Loop guard: after 2 denials the agent gets through, so a stubborn one
# cannot loop forever.
state_dir="${TMPDIR:-/tmp}/claude-handback"
count_file="$state_dir/$sid.$aid.count"
mkdir -p "$state_dir"
count=$(cat "$count_file" 2>/dev/null || echo 0)
[ "$count" -lt 2 ] || exit 0
echo $((count + 1)) >"$count_file"

reason="Hand-back $len characters, cap $cap. Keep result, file:line facts, open questions. Put longer detail in a tmp/ file (if you can write files) and cite its path."

if [ "$event" = PreToolUse ]; then
    jq -nc --arg r "$reason" '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}'
else
    jq -nc --arg r "$reason" '{decision:"block",reason:$r}'
fi
