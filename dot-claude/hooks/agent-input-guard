#!/opt/homebrew/bin/dash
# PreToolUse guard for Agent tool calls.
#
# Enforces two CLAUDE.md agent routing rules:
#   1. subagent_type must be a non-empty string.
#   2. model, if explicitly set, must be 'sonnet', 'haiku', or 'opus' with an
#      'ESCALATION:' justification line in the prompt. Anything else (notably
#      'fable') is denied outright.
#
# Subagents may delegate, under exactly these same rules. A strict
# equal-or-lesser-strength check against the caller's own model is not
# enforceable here: the PreToolUse payload carries agent_id and agent_type but
# no model, hooks get only CLAUDE_EFFORT in their environment, and the caller's
# tool_use message is not yet flushed to the transcript when the hook fires. The
# ESCALATION: requirement on opus is what keeps a nested dispatch from silently
# escalating upward.
#
# NOTE: The original Python used strict=False to allow literal control chars
# in JSON strings (e.g. raw newlines in the prompt field). jq requires valid
# JSON. If hook payloads ever contain unescaped control characters, revert to Python.

exec /opt/homebrew/bin/jq -c '
  .tool_input |
  if (.subagent_type // "") == "" then
    {hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:"CLAUDE.md agent routing: subagent_type must be set, never blank. Pick a specialized agent or \"general-purpose\"."}}
  elif (.model // "") == "" or .model == "sonnet" or .model == "haiku" then empty
  elif .model == "opus" then
    if ((.prompt // "") | test("(^|\n)[ \t]*ESCALATION:[ \t]*\\S")) then empty
    else
      {hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:"model=opus requires an ESCALATION: line in the dispatch prompt explaining why sonnet is insufficient (or that a sonnet attempt already failed). Add a line starting with \"ESCALATION:\" followed by the justification, or dispatch with model=sonnet."}}
    end
  else
    {hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:("subagent model must be sonnet, haiku, or opus (opus needs an ESCALATION: line); not " + (.model | @json) + ".")}}
  end
'
