#!/bin/sh
set -eu

payload=$(cat)
tool="" path=""  # set by eval below
eval "$(printf '%s' "$payload" | jq -r '"tool=" + (.tool_name // "" | @sh) + " path=" + (.tool_input.file_path // "" | @sh)')"

case "$tool" in
    Write|Edit|MultiEdit|mcp__*trueline_edit) ;;
    *) exit 0 ;;
esac

case "$path" in
    "$HOME"/.claude/plans/*.md) ;;
    *) exit 0 ;;
esac

# For Write, check the payload content (file doesn't exist yet); for every other tool, check the existing file
if [ "$tool" = "Write" ]; then
    check=$(printf '%s' "$payload" | jq -r '.tool_input.content // ""')
elif [ -f "$path" ]; then
    check=$(cat "$path")
else
    exit 0
fi

missing=""
printf '%s' "$check" | grep -qF '## Implementation via sub-agents' || missing="$missing sub-agents"

[ -z "$missing" ] && exit 0

# The section text lives here, not in CLAUDE.md: plans are rare, so one denied
# write costs less than carrying it in context every turn. Write, not Edit:
# for Edit this hook checks the pre-edit file, so adding the section is denied.
# shellcheck disable=SC2016 # backticks are literal markdown
printf 'plan-guard: %s missing required section(s):%s. Rewrite the file with Write, including verbatim:\n\n%s\n' \
    "$path" "$missing" '## Implementation via sub-agents

Implementation of this plan runs through specialized sub-agents as defined in the "Agent routing policy" (e.g., `feature-engineer`, `refactor-engineer`, etc.). Orchestrator never implements directly.' >&2
exit 2
